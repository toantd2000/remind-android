<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- ======================================================= -->
    <!-- 1. TIA NẮNG MẶT TRỜI                                    -->
    <!-- 12 Tia nắng đồng đều (Góc 0°, 30°, 60°) - Dài 12px       -->
    <!-- Màu: Orange inversePrimary (#FCB974)                     -->
    <!-- ======================================================= -->
    <!-- 4 Tia (12h, 6h, 9h, 3h) - Dài 12px -->
    <group>
        <path
            android:strokeColor="@color/icon_rays"
            android:strokeWidth="16"
            android:strokeLineCap="round"
            android:pathData="
                M256,118 L256,130
                M256,394 L256,382
                M118,256 L130,256
                M394,256 L382,256" />
    </group>

    <!-- 4 Tia góc 30 độ - Dài 12px -->
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:rotation="30">
        <path
            android:strokeColor="@color/icon_rays"
            android:strokeWidth="16"
            android:strokeLineCap="round"
            android:pathData="
                M256,118 L256,130
                M256,394 L256,382
                M118,256 L130,256
                M394,256 L382,256" />
    </group>

    <!-- 4 Tia góc 60 độ - Dài 12px -->
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:rotation="60">
        <path
            android:strokeColor="@color/icon_rays"
            android:strokeWidth="16"
            android:strokeLineCap="round"
            android:pathData="
                M256,118 L256,130
                M256,394 L256,382
                M118,256 L130,256
                M394,256 L382,256" />
    </group>

    <!-- ======================================================= -->
    <!-- 2. MẶT & VIỀN ĐỒNG HỒ                                   -->
    <!-- Nền mặt: Orange onSurfaceVariant (#50453A)               -->
    <!-- Viền: Orange inverseSurface (#372F28)                   -->
    <!-- Tâm (256,256), Bán kính R = 102                         -->
    <!-- ======================================================= -->
    <path
        android:fillColor="@color/icon_surface_container_high"
        android:strokeColor="@color/icon_clock_border"
        android:strokeWidth="18"
        android:pathData="M256,256m-102,0a102,102 0,1 1,204 0a102,102 0,1 1,-204 0" />

    <!-- ======================================================= -->
    <!-- 3. KIM ĐỒNG HỒ & CHẤM TÂM NỔI BẬT                       -->
    <!-- ======================================================= -->
    <!-- Kim Giờ (Orange secondaryContainer: #FEDCBE) -->
    <path
        android:strokeColor="@color/icon_hour_hand"
        android:strokeWidth="18"
        android:strokeLineCap="round"
        android:pathData="M256,256 L211,282" />

    <!-- Kim Phút (Orange tertiaryContainer: #DBE8B5) -->
    <path
        android:strokeColor="@color/icon_minute_hand"
        android:strokeWidth="18"
        android:strokeLineCap="round"
        android:pathData="M256,256 L306,206" />

    <!-- Chấm tâm đồng hồ (Viền: inverseSurface, ruột: primary #855317) -->
    <path
        android:fillColor="@color/icon_center_dot"
        android:strokeColor="@color/icon_clock_border"
        android:strokeWidth="4"
        android:pathData="M256,256m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0" />

</vector>
